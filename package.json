{
  "name": "newz-rip",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Cloudflare-native news reader and versioned article archive",
  "scripts": {
    "dev": "npm run build:web && wrangler dev",
    "build:web": "esbuild web/app.ts --bundle --minify --format=esm --outfile=public/app.js",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run build:web && wrangler deploy --dry-run --outdir dist",
    "deploy": "npm run build:web && wrangler deploy",
    "db:local": "wrangler d1 migrations apply newz-rip --local",
    "db:remote": "wrangler d1 migrations apply newz-rip --remote",
    "compat": "tsx scripts/compat.ts"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "linkedom": "0.18.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261011.1",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "miniflare": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  },
  "engines": {
    "node": ">=22"
  }
}
