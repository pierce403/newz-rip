{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "newz-rip",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "newz-rip",
      "database_id": "e10ef935-f4ba-4a53-b6f6-a1bf856e41cb",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARCHIVE",
      "bucket_name": "newz-rip-archive"
    }
  ],
  "vars": {
    "APP_NAME": "newz.rip",
    "ARCHIVE_PUBLIC": "true",
    "ALLOW_BROWSER_RENDERING": "false",
    "ALLOW_WAYBACK": "true"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "account_id": "b6d1478423f0bb0c0477df387305e46b"
}
